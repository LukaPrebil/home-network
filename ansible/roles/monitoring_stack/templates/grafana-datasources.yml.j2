---
# Grafana datasource provisioning
# Managed by Ansible - do not edit manually

apiVersion: 1

# Remove old datasources (without explicit UIDs) before re-creating with stable UIDs
deleteDatasources:
  - name: Prometheus
    orgId: 1
  - name: Loki
    orgId: 1

datasources:
  - name: Prometheus
    type: prometheus
    uid: prometheus
    access: proxy
    url: http://prometheus:{{ prometheus_port }}
    isDefault: true
    editable: false
    jsonData:
      timeInterval: 15s
      httpMethod: POST

  - name: Loki
    type: loki
    uid: loki
    access: proxy
    url: http://loki:{{ loki_port }}
    isDefault: false
    editable: false
    jsonData:
      maxLines: 1000
