# Monitoring stack secrets - managed by Ansible, do not edit manually
# Rendered at 0600; referenced by the grafana, proxmox-exporter and
# omada-exporter services. Compose v2 interpolates env_file values, so a $ in a
# secret must be doubled.
GF_SECURITY_ADMIN_PASSWORD="{{ monitoring_stack_grafana_admin_password | replace('$', '$$') }}"
PVE_USER="{{ vault_proxmox_api_user | replace('$', '$$') }}"
PVE_TOKEN_NAME="{{ vault_proxmox_api_token_name | replace('$', '$$') }}"
PVE_TOKEN_VALUE="{{ vault_proxmox_api_token_secret | replace('$', '$$') }}"
OMADA_USER="{{ vault_omada_controller_user | replace('$', '$$') }}"
OMADA_PASS="{{ vault_omada_controller_password | replace('$', '$$') }}"
