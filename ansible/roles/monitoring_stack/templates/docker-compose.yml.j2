---
# Docker Compose file for Monitoring Stack
# Managed by Ansible - do not edit manually

services:
  prometheus:
    image: prom/prometheus:{{ monitoring_stack_prometheus_version }}
    container_name: prometheus
    restart: unless-stopped
    command:
      - '--config.file=/etc/prometheus/prometheus.yml'
      - '--storage.tsdb.path=/prometheus'
      - '--storage.tsdb.retention.time={{ monitoring_stack_prometheus_retention }}'
      - '--web.console.libraries=/etc/prometheus/console_libraries'
      - '--web.console.templates=/etc/prometheus/consoles'
    networks:
      - {{ monitoring_stack_docker_network }}
    ports:
      - "{{ monitoring_stack_prometheus_port }}:9090"
    volumes:
      - {{ monitoring_stack_prometheus_config_dir }}/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - {{ monitoring_stack_prometheus_data_dir }}:/prometheus
    environment:
      - TZ={{ timezone | default('UTC') }}

  loki:
    image: grafana/loki:{{ monitoring_stack_loki_version }}
    container_name: loki
    restart: unless-stopped
    command: -config.file=/etc/loki/loki-config.yml
    networks:
      - {{ monitoring_stack_docker_network }}
    ports:
      - "{{ monitoring_stack_loki_port }}:3100"
    volumes:
      - {{ monitoring_stack_loki_config_dir }}/loki-config.yml:/etc/loki/loki-config.yml:ro
      - {{ monitoring_stack_loki_data_dir }}:/loki
    environment:
      - TZ={{ timezone | default('UTC') }}

  grafana:
    image: grafana/grafana:{{ monitoring_stack_grafana_version }}
    container_name: grafana
    restart: unless-stopped
    networks:
      - {{ monitoring_stack_docker_network }}
    ports:
      - "{{ monitoring_stack_grafana_port }}:3000"
    volumes:
      - {{ monitoring_stack_grafana_data_dir }}:/var/lib/grafana
      - {{ monitoring_stack_grafana_data_dir }}/provisioning:/etc/grafana/provisioning
    environment:
      - TZ={{ timezone | default('UTC') }}
      - GF_SECURITY_ADMIN_USER={{ monitoring_stack_grafana_admin_user }}
      - GF_SECURITY_ADMIN_PASSWORD={{ monitoring_stack_grafana_admin_password | replace('$', '$$') }}
      - GF_INSTALL_PLUGINS=
      - GF_USERS_ALLOW_SIGN_UP=false

  cadvisor:
    image: ghcr.io/google/cadvisor:{{ monitoring_stack_cadvisor_version }}
    container_name: cadvisor
    restart: unless-stopped
    privileged: true
    networks:
      - {{ monitoring_stack_docker_network }}
    ports:
      - "{{ monitoring_stack_cadvisor_port }}:8080"
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    devices:
      - /dev/kmsg
    environment:
      - TZ={{ timezone | default('UTC') }}

  proxmox-exporter:
    image: prompve/prometheus-pve-exporter:{{ monitoring_stack_proxmox_exporter_version }}
    container_name: proxmox-exporter
    restart: unless-stopped
    networks:
      - {{ monitoring_stack_docker_network }}
    ports:
      - "{{ monitoring_stack_proxmox_exporter_port }}:9221"
    environment:
      - TZ={{ timezone | default('UTC') }}
      - PVE_URL={{ monitoring_stack_proxmox_api_url }}
      - PVE_USER={{ vault_proxmox_api_user }}
      - PVE_TOKEN_NAME={{ vault_proxmox_api_token_name }}
      - PVE_TOKEN_VALUE={{ vault_proxmox_api_token_secret | replace('$', '$$') }}
      - PVE_VERIFY_SSL={{ monitoring_stack_proxmox_api_verify_ssl | string | lower }}

  omada-exporter:
    image: chhaley/omada_exporter:{{ monitoring_stack_omada_exporter_version }}
    container_name: omada-exporter
    restart: unless-stopped
    networks:
      - {{ monitoring_stack_docker_network }}
    ports:
      - "{{ monitoring_stack_omada_exporter_port }}:9202"
    environment:
      - TZ={{ timezone | default('UTC') }}
      - OMADA_HOST={{ monitoring_stack_omada_controller_url }}
      - OMADA_USER={{ vault_omada_controller_user }}
      - OMADA_PASS={{ vault_omada_controller_password | replace('$', '$$') }}
      - OMADA_SITE={{ monitoring_stack_omada_site }}
      - OMADA_INSECURE=true

  speedtest-exporter:
    image: billimek/prometheus-speedtest-exporter@{{ monitoring_stack_speedtest_exporter_digest }}
    container_name: speedtest-exporter
    restart: unless-stopped
    networks:
      - {{ monitoring_stack_docker_network }}
    ports:
      - "{{ monitoring_stack_speedtest_exporter_port }}:9469"
    environment:
      - TZ={{ timezone | default('UTC') }}
{% if monitoring_stack_speedtest_server_ids is defined and monitoring_stack_speedtest_server_ids %}
      - server_ids={{ monitoring_stack_speedtest_server_ids }}
{% endif %}

networks:
  {{ monitoring_stack_docker_network }}:
    external: true
