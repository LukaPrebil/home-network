---
# Docker Compose file for Arr Stack
# Managed by Ansible - do not edit manually

services:
  prowlarr:
    image: linuxserver/prowlarr:{{ arr_stack_prowlarr_version }}
    container_name: prowlarr
    restart: unless-stopped
    networks:
      - {{ arr_stack_docker_network }}
    ports:
      - "{{ arr_stack_prowlarr_port }}:9696"
    volumes:
      - {{ arr_stack_prowlarr_config_dir }}:/config
    environment:
      - TZ={{ arr_stack_timezone }}
      - PUID={{ arr_stack_puid }}
      - PGID={{ arr_stack_pgid }}

  flaresolverr:
    image: ghcr.io/flaresolverr/flaresolverr:{{ arr_stack_flaresolverr_version }}
    container_name: flaresolverr
    restart: unless-stopped
    networks:
      - {{ arr_stack_docker_network }}
    ports:
      - "{{ arr_stack_flaresolverr_port }}:8191"
    environment:
      - LOG_LEVEL=info
      - TZ={{ arr_stack_timezone }}

  sonarr:
    image: linuxserver/sonarr:{{ arr_stack_sonarr_version }}
    container_name: sonarr
    restart: unless-stopped
    networks:
      - {{ arr_stack_docker_network }}
    ports:
      - "{{ arr_stack_sonarr_port }}:8989"
    volumes:
      - {{ arr_stack_sonarr_config_dir }}:/config
      - {{ arr_stack_media_tv_dir }}:/tv
      - {{ arr_stack_media_downloads_dir }}:/downloads
    environment:
      - TZ={{ arr_stack_timezone }}
      - PUID={{ arr_stack_puid }}
      - PGID={{ arr_stack_pgid }}

  radarr:
    image: linuxserver/radarr:{{ arr_stack_radarr_version }}
    container_name: radarr
    restart: unless-stopped
    networks:
      - {{ arr_stack_docker_network }}
    ports:
      - "{{ arr_stack_radarr_port }}:7878"
    volumes:
      - {{ arr_stack_radarr_config_dir }}:/config
      - {{ arr_stack_media_movies_dir }}:/movies
      - {{ arr_stack_media_downloads_dir }}:/downloads
    environment:
      - TZ={{ arr_stack_timezone }}
      - PUID={{ arr_stack_puid }}
      - PGID={{ arr_stack_pgid }}

  bazarr:
    image: linuxserver/bazarr:{{ arr_stack_bazarr_version }}
    container_name: bazarr
    restart: unless-stopped
    networks:
      - {{ arr_stack_docker_network }}
    ports:
      - "{{ arr_stack_bazarr_port }}:6767"
    volumes:
      - {{ arr_stack_bazarr_config_dir }}:/config
      - {{ arr_stack_media_movies_dir }}:/movies
      - {{ arr_stack_media_tv_dir }}:/tv
    environment:
      - TZ={{ arr_stack_timezone }}
      - PUID={{ arr_stack_puid }}
      - PGID={{ arr_stack_pgid }}

  qbittorrent:
    image: linuxserver/qbittorrent:{{ arr_stack_qbittorrent_version }}
    container_name: qbittorrent
    restart: unless-stopped
    networks:
      - {{ arr_stack_docker_network }}
    ports:
      - "{{ arr_stack_qbittorrent_port_web }}:8080"  # Web UI
      - "{{ arr_stack_qbittorrent_port_bt }}:6881/tcp"  # BitTorrent
      - "{{ arr_stack_qbittorrent_port_bt }}:6881/udp"  # BitTorrent
    volumes:
      - {{ arr_stack_qbittorrent_config_dir }}:/config
      - {{ arr_stack_media_downloads_dir }}:/downloads
    environment:
      - TZ={{ arr_stack_timezone }}
      - PUID={{ arr_stack_puid }}
      - PGID={{ arr_stack_pgid }}
      - WEBUI_PORT=8080

  seerr:
    image: seerr/seerr:{{ arr_stack_seerr_version }}
    container_name: seerr
    restart: unless-stopped
    networks:
      - {{ arr_stack_docker_network }}
    ports:
      - "{{ arr_stack_seerr_port }}:5055"
    volumes:
      - {{ arr_stack_seerr_config_dir }}:/app/config
    environment:
      - TZ={{ arr_stack_timezone }}

networks:
  {{ arr_stack_docker_network }}:
    driver: bridge
