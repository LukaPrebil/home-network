#!/usr/bin/env bash
# Managed by Ansible. Weekly pre-upgrade snapshot of declared VMs, keep last 4.
#
# VMIDs are sourced from group_vars/vms.yml at template time: every VM with
# snapshot_weekly: true is included. Re-render and redeploy the script via
# the proxmox role to add or remove VMs from this list.
set -euo pipefail

LABEL="auto-$(date +%Y-%m-%d)"
KEEP=4
PRUNE_FAILED=0

VMIDS=({% for vm in vms_to_create | selectattr('snapshot_weekly', 'defined') | selectattr('snapshot_weekly', 'equalto', true) | list %}{{ vm.vmid }} {% endfor %})

{% raw %}
if [[ ${#VMIDS[@]} -eq 0 ]]; then
  echo "[snapshot-vms] $(date -Iseconds) no VMs flagged snapshot_weekly; nothing to do"
  exit 0
fi
{% endraw %}

for vmid in "${VMIDS[@]}"; do
  echo "[snapshot-vms] $(date -Iseconds) snapshotting $vmid as $LABEL"
  if ! qm snapshot "$vmid" "$LABEL" --description "Auto weekly pre-upgrade snapshot"; then
    echo "[snapshot-vms] WARN: snapshot failed for $vmid (continuing)"
    continue
  fi

  # Prune: keep only the most recent $KEEP "auto-*" snapshots.
  # qm listsnapshot prefixes each line with a tree glyph as field 1, so the
  # snapshot name is not at a fixed position; match the auto-* token itself.
  mapfile -t old < <(qm listsnapshot "$vmid" 2>/dev/null \
    | awk '{ for (i = 1; i <= NF; i++) if ($i ~ /^auto-[0-9]/) { print $i; break } }' \
    | sort \
    | head -n -"$KEEP" || true)
  for snap in "${old[@]}"; do
    [[ -z "$snap" ]] && continue
    echo "[snapshot-vms] pruning $vmid:$snap"
    if ! qm delsnapshot "$vmid" "$snap"; then
      echo "[snapshot-vms] ERROR: prune failed for $vmid:$snap"
      PRUNE_FAILED=1
    fi
  done
done

if [[ "$PRUNE_FAILED" -ne 0 ]]; then
  echo "[snapshot-vms] $(date -Iseconds) finished with prune failures (see ERROR lines above)"
  exit 1
fi
