---
# AdGuard Home configuration
# Generated by Ansible - DO NOT EDIT MANUALLY

http:
  pprof:
    port: 6060
    enabled: false
  address: {{ adguard_bind_host }}:{{ adguard_bind_port }}
  session_ttl: {{ adguard_session_ttl }}
{% if vault_adguard_username is defined and adguard_password_hash is defined %}
users:
  - name: {{ vault_adguard_username }}
    password: {{ adguard_password_hash.stdout }}
{% else %}
users: []
{% endif %}

auth_attempts: 5
block_auth_min: 15

http_proxy: ""
language: ""
theme: auto

dns:
  bind_hosts:
    - {{ adguard_bind_host }}
  port: {{ adguard_dns_port }}
  anonymize_client_ip: {{ adguard_querylog_anonymize_client_ip | lower }}
  ratelimit: {{ adguard_ratelimit }}
  ratelimit_subnet_len_ipv4: 24
  ratelimit_subnet_len_ipv6: 56
  ratelimit_whitelist: []
  refuse_any: true
  upstream_dns:
{% for upstream in adguard_upstream_dns %}
    - {{ upstream }}
{% endfor %}
  upstream_dns_file: ""
  bootstrap_dns:
{% for bootstrap in adguard_bootstrap_dns %}
    - {{ bootstrap }}
{% endfor %}
  fallback_dns:
{% for fallback in adguard_fallback_dns %}
    - {{ fallback }}
{% endfor %}
  upstream_mode: load_balance
  fastest_timeout: 1s
  allowed_clients: []
  disallowed_clients: []
  blocked_hosts:
    - version.bind
    - id.server
    - hostname.bind
  trusted_proxies:
    - 127.0.0.0/8
    - "::1/128"
  cache_enabled: true
  cache_size: 4194304
  cache_ttl_min: 0
  cache_ttl_max: 0
  cache_optimistic: {{ adguard_cache_optimistic | lower }}
  cache_optimistic_answer_ttl: 30s
  cache_optimistic_max_age: 12h
  bogus_nxdomain: []
  aaaa_disabled: false
  enable_dnssec: {{ adguard_dnssec_enabled | lower }}
  edns_client_subnet:
    custom_ip: ""
    enabled: false
    use_custom: false
  max_goroutines: 300
  handle_ddr: true
  ipset: []
  ipset_file: ""
  bootstrap_prefer_ipv6: false
  upstream_timeout: 10s
  private_networks: []
  use_private_ptr_resolvers: {{ adguard_use_private_ptr_resolvers | lower }}
  local_ptr_upstreams: []
  use_dns64: false
  dns64_prefixes: []
  serve_http3: false
  use_http3_upstreams: false
  serve_plain_dns: true
  hostsfile_enabled: true
  pending_requests:
    enabled: true

tls:
  enabled: false
  server_name: ""
  force_https: false
  port_https: 443
  port_dns_over_tls: 853
  port_dns_over_quic: 853
  port_dnscrypt: 0
  dnscrypt_config_file: ""
  allow_unencrypted_doh: false
  certificate_chain: ""
  private_key: ""
  certificate_path: ""
  private_key_path: ""
  strict_sni_check: false

querylog:
  dir_path: ""
  ignored: []
  interval: {{ adguard_querylog_interval }}
  size_memory: 1000
  enabled: {{ adguard_querylog_enabled | lower }}
  file_enabled: true

statistics:
  dir_path: ""
  ignored: []
  interval: {{ adguard_statistics_interval }}
  enabled: true

filters:
{% for filter in adguard_filters %}
  - enabled: {{ filter.enabled | lower }}
    url: {{ filter.url }}
    name: {{ filter.name }}
    id: {{ filter.id }}
{% endfor %}

whitelist_filters: []

user_rules:
{% for rule in adguard_user_rules %}
  - '{{ rule }}'
{% endfor %}

dhcp:
  enabled: {{ adguard_dhcp_enabled | lower }}
  interface_name: ""
  local_domain_name: lan
  dhcpv4:
    gateway_ip: ""
    subnet_mask: ""
    range_start: ""
    range_end: ""
    lease_duration: 86400
    icmp_timeout_msec: 1000
    options: []
  dhcpv6:
    range_start: ""
    lease_duration: 86400
    ra_slaac_only: false
    ra_allow_slaac: false

filtering:
  blocking_ipv4: ""
  blocking_ipv6: ""
  blocked_services:
    schedule:
      time_zone: {{ timezone | default('Europe/Ljubljana') }}
    ids: []
  protection_disabled_until: null
  safe_search:
    enabled: {{ adguard_safesearch_enabled | lower }}
    bing: true
    duckduckgo: true
    ecosia: true
    google: true
    pixabay: true
    yandex: true
    youtube: true
  blocking_mode: default
  parental_block_host: family-block.dns.adguard.com
  safebrowsing_block_host: standard-block.dns.adguard.com
  rewrites:
{% for rewrite in adguard_dns_rewrites %}
    - domain: {{ rewrite.domain }}
      answer: {{ rewrite.answer }}
      enabled: true
{% endfor %}
  safe_fs_patterns: []
  safebrowsing_cache_size: 1048576
  safesearch_cache_size: 1048576
  parental_cache_size: 1048576
  cache_time: 30
  filters_update_interval: 1
  blocked_response_ttl: 10
  filtering_enabled: {{ adguard_filtering_enabled | lower }}
  rewrites_enabled: true
  parental_enabled: {{ adguard_parental_enabled | lower }}
  safebrowsing_enabled: {{ adguard_safebrowsing_enabled | lower }}
  protection_enabled: true

clients:
  runtime_sources:
    whois: true
    arp: true
    rdns: true
    dhcp: true
    hosts: true
  persistent: []

log:
  enabled: true
  file: ""
  max_backups: 0
  max_size: 100
  max_age: 3
  compress: false
  local_time: false
  verbose: false

os:
  group: ""
  user: ""
  rlimit_nofile: 0

schema_version: 32
