---
# AdGuard Home configuration
# Generated by Ansible - DO NOT EDIT MANUALLY

bind_host: {{ adguard_bind_host }}
bind_port: {{ adguard_bind_port }}
{% if vault_adguard_username is defined and adguard_password_hash is defined %}
users:
  - name: {{ vault_adguard_username }}
    password: {{ adguard_password_hash.stdout }}
{% else %}
users: []  # Will be configured via web UI on first run
{% endif %}

auth_attempts: 5
block_auth_min: 15

http_proxy: ""
language: ""
theme: auto

dns:
  bind_hosts:
    - {{ adguard_bind_host }}
  port: {{ adguard_dns_port }}

  # Anonymize client IPs in query logs for privacy
  anonymize_client_ip: {{ adguard_querylog_anonymize_client_ip | lower }}

  # Upstream DNS servers (encrypted for privacy)
  upstream_dns:
{% for upstream in adguard_upstream_dns %}
    - "{{ upstream }}"
{% endfor %}

  # Bootstrap DNS (plain DNS to resolve DoH/DoT server names)
  bootstrap_dns:
{% for bootstrap in adguard_bootstrap_dns %}
    - {{ bootstrap }}
{% endfor %}

  # Fallback DNS (if encrypted DNS fails)
  fallback_dns:
{% for fallback in adguard_fallback_dns %}
    - {{ fallback }}
{% endfor %}

  # Parallel requests to all upstream servers
  all_servers: false
  fastest_addr: false

  # DNS cache
  cache_size: 4194304  # 4MB
  cache_ttl_min: 0
  cache_ttl_max: 0
  cache_optimistic: true

  # DNSSEC validation
  enable_dnssec: true

  # EDNS Client Subnet
  edns_client_subnet:
    custom_ip: ""
    enabled: false
    use_custom: false

  # Rate limiting
  ratelimit: {{ adguard_ratelimit }}
  ratelimit_subnet_len_ipv4: 24
  ratelimit_subnet_len_ipv6: 56
  ratelimit_whitelist: []

  # Refused domains
  refuse_any: true

  # DNS-over-HTTPS
  upstream_dns_file: ""

  # Local PTR resolving
  use_private_ptr_resolvers: true
  local_ptr_upstreams: []

  # Blocked services
  blocked_services:
    schedule:
      time_zone: Europe/Ljubljana
    ids: []

  # DNS64
  dns64_prefixes: []

  # Upstream mode
  upstream_mode: load_balance

  # Fastest timeout
  fastest_timeout: 1s

tls:
  enabled: false
  server_name: ""
  force_https: false
  port_https: 443
  port_dns_over_tls: 853
  port_dns_over_quic: 853
  port_dnscrypt: 0
  dnscrypt_config_file: ""
  allow_unencrypted_doh: false
  certificate_chain: ""
  private_key: ""
  certificate_path: ""
  private_key_path: ""
  strict_sni_check: false

querylog:
  enabled: {{ adguard_querylog_enabled | lower }}
  file_enabled: true
  interval: {{ adguard_querylog_interval }}
  size_memory: 1000
  ignored: []

statistics:
  enabled: true
  interval: {{ adguard_statistics_interval }}
  ignored: []

filters:
  - enabled: {{ adguard_filtering_enabled | lower }}
    url: https://adguardteam.github.io/HostlistsRegistry/assets/filter_1.txt
    name: AdGuard DNS filter
    id: 1
  - enabled: {{ adguard_filtering_enabled | lower }}
    url: https://adguardteam.github.io/HostlistsRegistry/assets/filter_2.txt
    name: AdAway Default Blocklist
    id: 2

whitelist_filters: []

user_rules: []

dhcp:
  enabled: {{ adguard_dhcp_enabled | lower }}
  interface_name: ""
  local_domain_name: lan
  dhcpv4:
    gateway_ip: ""
    subnet_mask: ""
    range_start: ""
    range_end: ""
    lease_duration: 86400
    icmp_timeout_msec: 1000
    options: []
  dhcpv6:
    range_start: ""
    lease_duration: 86400
    ra_slaac_only: false
    ra_allow_slaac: false

filtering:
  blocking_ipv4: ""
  blocking_ipv6: ""
  blocked_response_ttl: 10
  protection_enabled: {{ adguard_filtering_enabled | lower }}
  blocking_mode: default
  parental_block_host: family-block.dns.adguard.com
  safebrowsing_block_host: standard-block.dns.adguard.com

  # Safe Browsing
  safebrowsing_enabled: {{ adguard_safebrowsing_enabled | lower }}
  safebrowsing_cache_size: 1048576
  safesearch_cache_size: 1048576

  # Parental Control
  parental_enabled: {{ adguard_parental_enabled | lower }}
  parental_sensitivity: 0

  # Safe Search
  safe_search:
    enabled: {{ adguard_safesearch_enabled | lower }}
    bing: true
    duckduckgo: true
    google: true
    pixabay: true
    yandex: true
    youtube: true

  # DNS Rewrites - Local hostname to IP mappings
  rewrites:
{% for rewrite in adguard_dns_rewrites %}
    - domain: {{ rewrite.domain }}
      answer: {{ rewrite.answer }}
{% endfor %}

clients:
  runtime_sources:
    whois: true
    arp: true
    rdns: true
    dhcp: true
    hosts: true
  persistent: []

log:
  file: ""
  max_backups: 0
  max_size: 100
  max_age: 3
  compress: false
  local_time: false
  verbose: false

os:
  group: ""
  user: ""
  rlimit_nofile: 0

schema_version: 30
