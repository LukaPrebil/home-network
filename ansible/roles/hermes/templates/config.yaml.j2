{# Hermes config.yaml — managed by Ansible. Hand-edits will be overwritten. #}
# Hermes Agent configuration
# Source: roles/hermes/templates/config.yaml.j2

# ── Model / inference ────────────────────────────────────────────────
# Brain provider + model come from role defaults; auth is the matching
# API key block in .env (OLLAMA_API_KEY for ollama-cloud, etc.). Switching
# brains = change hermes_model_provider/hermes_model_default + paste key.
model:
  provider: "{{ hermes_model_provider }}"
  default: "{{ hermes_model_default }}"

# ── Auxiliary models ─────────────────────────────────────────────────
# Side tasks run on their own provider/model, so the brain's pin does not decide
# them. Only vision is configured: it is the one aux lane this host depends on,
# because reading listing photos is how an airbag verdict stops being a guess.
#
# The pin lives in the role defaults, not only in this file, so a redeploy cannot
# quietly move it back to minimax-m3. glm-5.3-flash takes an image natively and
# is cheap; never pin kimi-k3 here, which costs an order of magnitude more for
# no better reading of the same airbag photos.
#
# Upstream falls back to a paid OpenRouter model when a configured aux provider
# is unavailable; OPENROUTER_API_KEY is unset here, so that lane stays inert.
auxiliary:
  vision:
    provider: "{{ hermes_vision_provider }}"
    model: "{{ hermes_vision_model }}"

# ── Provider model allowlist ─────────────────────────────────────────
# Cost control: discover_models false stops hermes live-probing the provider
# catalog whenever the picker opens, and the list below narrows the picker to the
# models this host actually uses, so an expensive model is not picked out of
# habit.
#
# Be clear about what this buys: the list is picker-only. It does not gate
# requests - hermes has no model denylist - so the pins above and in `model` are
# what bound spending. Keep both pins in this list or the picker cannot offer the
# model that is actually in use; configure.yml fails the converge otherwise.
providers:
  ollama-cloud:
    discover_models: false
    models:
{% for model in hermes_ollama_cloud_models %}
      - "{{ model }}"
{% endfor %}

# ── Security gate ────────────────────────────────────────────────────
# manual: a dangerous terminal command becomes a propose-wait prompt in the
# Telegram chat rather than running. The command allowlist is narrow, and an
# unattended run - cron job or event wake - has no approver present, so manual
# mode fails those closed instead of letting them act. Valid upstream modes are
# smart | manual | off; there is no "on".
approvals:
  mode: "{{ hermes_approvals_mode }}"

# ── Terminal sandbox ─────────────────────────────────────────────────
# local: the LXC is the sandbox, so commands run inside its rootfs. A docker
# backend would only add a second isolation layer this host does not need.
terminal:
  backend: "{{ hermes_terminal_backend }}"

# ── Gateway / platforms ──────────────────────────────────────────────
# A platform is enabled by its token in .env (TELEGRAM_BOT_TOKEN etc.); the
# gateway reads the env directly, so listing a platform here is not what turns
# it on. Disabling one is done by leaving its token unset. The dashboard is a
# separate process (`hermes dashboard`, own systemd unit) bound in that unit's
# args.
#
# Home Assistant is the exception: its `extra` block carries the event filters,
# which have no env equivalent. Upstream is closed by default - with none of
# watch_domains/watch_entities/watch_all set it logs a startup warning and drops
# every state change, so an empty list here is a silent no-op rather than an
# error.
#
# The list is a budget, not a feed: roughly 700-800k changes/day arrive on the
# raw feed and this one is capped in the low tens. Every entry must pass the
# watch-decision gate recorded next to the list in the role defaults, which is
# also where the per-entity reasons live. The mower pair is commented out while
# the mower sits in winter storage - a wake that cannot act is waste.
{% if hermes_enable_homeassistant %}
platforms:
  homeassistant:
    extra:
      watch_entities:
{% for entity in hermes_ha_watch_entities %}
        - {{ entity }}
{% endfor %}
      cooldown_seconds: {{ hermes_ha_cooldown_seconds }}
    # The wake turn answers this channel as an HA persistent notification, which
    # nobody reads away from a browser, so the agent is redirected to Telegram.
    # Upstream resolves this override by chat_id; the adapter hardcodes
    # "ha_events" as the chat id for every state-change event.
    channel_overrides:
      ha_events:
        system_prompt: {{ hermes_ha_channel_prompt | to_json }}
{% endif %}

# ── Tool surface ─────────────────────────────────────────────────────
# agent.disabled_toolsets is a global suppression list that upstream applies
# last, overriding per-platform toolset lists. The built-in homeassistant
# toolset is on it because setting HASS_TOKEN switches that toolset on by
# itself: a second HA service-call path that the ha-mcp include whitelist does
# not govern. Suppressing it keeps the ha-mcp server the single HA tool surface,
# so there is one privilege boundary and one result shape.
#
# image_input_mode: text keeps an attached photo out of a native attach. The
# brain's catalog entry claims image input it does not honour, so a native
# attach answers as though no image arrived; text mode pre-analyses with the
# auxiliary vision model instead and prepends the description.
{% if hermes_disabled_toolsets or hermes_image_input_mode %}
agent:
{% if hermes_image_input_mode %}
  image_input_mode: "{{ hermes_image_input_mode }}"
{% endif %}
{% if hermes_disabled_toolsets %}
  disabled_toolsets:
{% for toolset in hermes_disabled_toolsets %}
    - {{ toolset }}
{% endfor %}
{% endif %}
{% endif %}

# ── Cron ─────────────────────────────────────────────────────────────
# Knobs for the scheduled jobs (hermes cron create writes jobs.json, which this
# role does not template). mirror_delivery mirrors a delivered alert into a
# session so replying to it continues with the listing in context, and
# wrap_response drops the cron header/footer so the alert reads as the message
# the operator wrote it as.
{% if hermes_enable_ev_hunt %}
cron:
  mirror_delivery: true
  wrap_response: false
{% endif %}

# ── MCP servers ──────────────────────────────────────────────────────
# Home Assistant MCP is bridged from the containers VM. It exposes HA
# device control as tools - useful for "turn off the heat pump" style
# requests from Telegram. tools.include is a whitelist (empty = nothing
# registered); the list lives in role defaults, one entry per tool.
mcp_servers:
  ha-mcp:
    # Streamable HTTP at the ha-mcp secret path (the path is the credential,
    # declared in group_vars/all alongside the port contract). ha-mcp-web
    # serves no /sse endpoint; the former /sse URL here was a 404.
    url: "http://{{ hostvars['containers']['ansible_host'] }}:8087{{ ha_mcp_secret_path }}"
    enabled: {{ hermes_enable_hamcp | lower }}
    # tools.include is the HA privilege boundary: read + service-call only,
    # no automation/script/helper authoring (see role defaults for why).
    tools:
      include:
{% for tool in hermes_hamcp_include_tools %}
        - {{ tool }}
{% endfor %}
    sampling:
      enabled: false  # Don't let the MCP server initiate LLM calls on our budget

# ── First-touch hints ────────────────────────────────────────────────
# hermes records each one-time onboarding hint under onboarding.seen when the
# operator first meets it. This role owns the file wholesale, so the flag is
# spelled out here: omitting it re-arms the busy-input tip and shows it again on
# the next message that arrives mid-run.
onboarding:
  seen:
    busy_input_prompt: true
