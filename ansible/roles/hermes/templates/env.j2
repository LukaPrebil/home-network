{# Hermes ~/.hermes/.env — secrets. Managed by Ansible, 0600. #}
# Hermes Agent environment / secrets
# Source: roles/hermes/templates/env.j2
# Mode 0600 — operator-only readable.

# ── Anthropic auth (Claude Max via Claude Code OAuth) ────────────────
# Reuses the OAuth token Claude Code already minted. Refresh logic in the
# Anthropic adapter handles renewal. Falls back to ANTHROPIC_API_KEY if
# the OAuth token is empty.
CLAUDE_CODE_OAUTH_TOKEN={{ vault_hermes_claude_code_oauth_token | default('') }}

{% if hermes_enable_telegram %}
# ── Telegram gateway ─────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN={{ vault_hermes_telegram_bot_token | default('') }}
# Comma-separated Telegram user IDs allowed to talk to the bot.
# Use @userinfobot on Telegram to look yours up.
TELEGRAM_ALLOWED_USERS={{ vault_hermes_telegram_allowed_users | default('') }}
{% endif %}

{% if hermes_enable_homeassistant %}
# ── Home Assistant WebSocket ─────────────────────────────────────────
HASS_URL={{ hermes_hass_url }}
HASS_TOKEN={{ vault_hermes_hass_token | default('') }}
{% endif %}
