# Custom Immich ML image with ROCm 6.4.4 for gfx1150 (RDNA 3.5) support
# Base image: Official Immich ML with ROCm 6.4.3 (doesn't fully support gfx1150)
# This Dockerfile upgrades ROCm to 6.4.4 for AMD Radeon 880M/890M compatibility
# Generated by Ansible - DO NOT EDIT MANUALLY
FROM ghcr.io/immich-app/immich-machine-learning:{{ immich_version }}-rocm

# Switch to root user to install packages
USER root

# Add AMD ROCm 6.4.4 repository
# ROCm 6.4.4+ is required for gfx1150/gfx1151 GPU architecture support
RUN apt-get update && apt-get install -y wget gnupg
RUN wget -qO - https://repo.radeon.com/rocm/rocm.gpg.key | apt-key add -
RUN echo "deb [arch=amd64] https://repo.radeon.com/rocm/apt/6.4.4/ ubuntu main" | tee /etc/apt/sources.list.d/rocm.list

# Upgrade ROCm from 6.4.3 (base image) to 6.4.4 for gfx1150 support
# Installs HIP SDK, runtime libraries, and ONNX Runtime with ROCm backend
RUN apt-get update && \
    apt-get install -y --allow-downgrades \
    rocm-hip-sdk \
    rocm-libs \
    rocm-onnxruntime && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

# Switch back to the non-root user that Immich runs as
USER immich