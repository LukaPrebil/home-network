# Immich Environment Configuration
# Generated by Ansible - DO NOT EDIT MANUALLY

# Immich Version
IMMICH_VERSION={{ immich_version }}

# Upload Location
# This is where your photos/videos will be stored
UPLOAD_LOCATION={{ immich_upload_dir }}

# Database Configuration
DB_HOSTNAME={{ immich_db_hostname }}
DB_USERNAME={{ immich_db_user }}
DB_DATABASE_NAME={{ immich_db_name }}
DB_PASSWORD={{ vault_immich_db_password }}
DB_DATA_LOCATION={{ immich_base_dir }}/database

# Redis Configuration
REDIS_HOSTNAME={{ immich_redis_hostname }}

# Immich Configuration
LOG_LEVEL={{ immich_log_level }}

# Machine Learning Configuration
{% if immich_enable_rocm %}
# AMD ROCm GPU acceleration for machine learning
# Radeon 880M/890M (RDNA 3.5, gfx1150 architecture)
{% if immich_hsa_override %}
# HSA GFX version override for GPU compatibility
HSA_OVERRIDE_GFX_VERSION={{ immich_hsa_override }}
{% endif %}
# MIGraphX performance tuning (v2.6.0+ uses MIGraphX instead of ROCM provider)
# Disabling fusion kernels improves inference speed on most AMD GPUs
MIGRAPHX_DISABLE_MIOPEN_FUSION=1
MIGRAPHX_DISABLE_SCHEDULE_PASS=1
MIGRAPHX_DISABLE_REDUCE_FUSION=1
MIGRAPHX_ENABLE_HIPRTC_WORKAROUNDS=1
{% endif %}
# --- 2. THE SILENCERS (Thread Clamping) ---
# Forces the library to just use 1 thread per task.
# Since you are using the "Mobile" model, 1 thread is actually FASTER 
# than the overhead of managing 24 threads.
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
ORT_INTRA_OP_NUM_THREADS=1
ORT_INTER_OP_NUM_THREADS=1

# --- 3. DISABLE AFFINITY BINDING ---
# Explicitly tells the underlying libraries not to touch CPU pinning.
OMP_PROC_BIND=false
KMP_AFFINITY=disabled

# Optional: Control GPU power management
# Higher values (in seconds) = longer before GPU powers down after inference
# MACHINE_LEARNING_MODEL_TTL=300

# Timezone
TZ=Europe/Ljubljana
