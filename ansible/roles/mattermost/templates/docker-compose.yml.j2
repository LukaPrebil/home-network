# Mattermost Docker Compose - generated by Ansible, DO NOT EDIT MANUALLY

name: mattermost

services:
  mattermost:
    container_name: mattermost
    image: {{ mattermost_image }}
    restart: always
    depends_on:
      database:
        condition: service_healthy
    ports:
      - "{{ mattermost_port }}:8065"
    env_file:
      - .env
    volumes:
      - {{ mattermost_config_dir }}:/mattermost/config
      - {{ mattermost_uploads_mount }}:/mattermost/data
      - {{ mattermost_logs_dir }}:/mattermost/logs
      - {{ mattermost_plugins_dir }}:/mattermost/plugins
      - {{ mattermost_client_plugins_dir }}:/mattermost/client/plugins
      - /etc/localtime:/etc/localtime:ro
    healthcheck:
      # The team-edition image is minimal (no curl/wget/shell), so the only
      # in-container probe is mmctl over the local-mode unix socket.
      test: ["CMD", "/mattermost/bin/mmctl", "system", "status", "--local"]
      interval: 30s
      timeout: 10s
      retries: 5
      start_period: 90s
    labels:
      - "autoheal=true"

  database:
    container_name: mattermost_postgres
    image: {{ mattermost_postgres_image }}
    restart: always
    environment:
      POSTGRES_USER: ${DB_USERNAME}
      POSTGRES_PASSWORD: ${DB_PASSWORD}
      POSTGRES_DB: ${DB_DATABASE_NAME}
    volumes:
      # PG18+ images store data in a versioned subdir and refuse to start if the
      # volume is mounted at the legacy .../data path, so mount the postgres home.
      - {{ mattermost_db_data_dir }}:/var/lib/postgresql
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${DB_USERNAME} -d ${DB_DATABASE_NAME}"]
      interval: 30s
      timeout: 5s
      retries: 5
