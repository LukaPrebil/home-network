# Mattermost environment - generated by Ansible, DO NOT EDIT MANUALLY

# --- Postgres container (consumed via ${...} interpolation in compose) ---
DB_USERNAME={{ mattermost_db_user }}
DB_DATABASE_NAME={{ mattermost_db_name }}
# Compose interpolates unquoted env-file values ($$ = literal $)
DB_PASSWORD={{ vault_mattermost_postgres_password | replace('$', '$$') }}

# --- Mattermost server (MM_* env vars override config.json) ---
MM_SQLSETTINGS_DRIVERNAME=postgres
# Password is URL-encoded for the DSN; decodes back to DB_PASSWORD above
MM_SQLSETTINGS_DATASOURCE=postgres://{{ mattermost_db_user }}:{{ vault_mattermost_postgres_password | urlencode }}@{{ mattermost_db_hostname }}:5432/{{ mattermost_db_name }}?sslmode=disable&connect_timeout=10

# Public URL behind Cloudflare + Traefik; MUST be the external HTTPS URL or
# Mattermost mis-builds links and WebSockets fail
MM_SERVICESETTINGS_SITEURL={{ mattermost_site_url }}
# Local mode unix socket so `mmctl --local` can bootstrap team/channels/bot
MM_SERVICESETTINGS_ENABLELOCALMODE={{ mattermost_enable_local_mode | lower }}

# Onboarding: invite-link only; open self-registration disabled
MM_TEAMSETTINGS_ENABLEOPENSERVER={{ mattermost_enable_open_server | lower }}
MM_TEAMSETTINGS_ENABLEUSERCREATION={{ mattermost_enable_user_creation | lower }}

# No SMTP relay: disable email notifications and email verification (invite-link
# onboarding, admin-driven password resets via mmctl)
MM_EMAILSETTINGS_SENDEMAILNOTIFICATIONS=false
MM_EMAILSETTINGS_REQUIREEMAILVERIFICATION=false

# Mobile push via TPNS (free, best-effort; HPNS is paid, Team Edition excluded)
MM_EMAILSETTINGS_SENDPUSHNOTIFICATIONS=true
MM_EMAILSETTINGS_PUSHNOTIFICATIONSERVER={{ mattermost_push_server }}
MM_EMAILSETTINGS_PUSHNOTIFICATIONCONTENTS=full

# Uploads land on the mounted, encrypted NFS data dir
MM_FILESETTINGS_DIRECTORY=/mattermost/data/

# Timezone
TZ={{ timezone }}
