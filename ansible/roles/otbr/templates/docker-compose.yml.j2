---
# Docker Compose for OpenThread Border Router (OTBR)
# Managed by Ansible - DO NOT EDIT MANUALLY
#
# Services:
#   - OpenThread Border Router (OTBR) - Thread network coordinator

services:
  otbr:
    image: {{ otbr_image }}:{{ otbr_version }}
    container_name: {{ otbr_container_name }}
    restart: unless-stopped
    # OTBR requires privileged mode for:
    # - USB device access
    # - Network namespace manipulation (wpan0 interface)
    # - iptables for NAT64/DNS64
    privileged: true
    # Host networking required for Thread/mDNS
    network_mode: host
    volumes:
      - {{ otbr_data_dir }}:/var/lib/thread
    devices:
      - {{ thread_usb_device }}:/dev/ttyUSB0
    environment:
      TZ: {{ otbr_timezone }}
      # Radio URL for the Thread dongle
      RADIO_URL: "spinel+hdlc+uart:///dev/ttyUSB0?uart-baudrate=460800&uart-flow-control=0"
      # Backbone interface for border routing
      BACKBONE_IF: "{{ otbr_backbone_interface }}"
      BORDER_ROUTING: "1"
      BACKBONE_ROUTER: "1"
      NAT64: "0"
      DNS64: "0"
      WEB_GUI: "1"
      REST_API: "1"
      # Bind REST API to all interfaces so it's accessible from other hosts
      REST_HOST: "0.0.0.0"
      # Bind Web GUI to all interfaces
      HTTP_HOST: "0.0.0.0"
      HTTP_PORT: "{{ otbr_port_web }}"
    # Note: sysctls cannot be used with network_mode: host
    # IP forwarding is configured on the host via prerequisites.yml
    healthcheck:
      # Check if otbr-agent process is running (state can be 'disabled' until network is formed)
      test: ["CMD-SHELL", "pgrep -x otbr-agent > /dev/null"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s
    labels:
      - "autoheal=true"
