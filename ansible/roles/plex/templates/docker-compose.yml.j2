---
# Docker Compose file for Plex Media Server
# Managed by Ansible - do not edit manually

services:
  plex:
    image: plexinc/pms-docker:{{ plex_version }}
    container_name: plex
    restart: unless-stopped
    network_mode: "{{ plex_network }}"
{% if plex_network != 'host' %}
    ports:
      - "{{ plex_port }}:32400/tcp"  # Plex Web UI
      - "1900:1900/udp"  # DLNA
      - "3005:3005/tcp"  # Plex Companion
      - "8324:8324/tcp"  # Plex for Roku
      - "32410:32410/udp"  # GDM network discovery
      - "32412:32412/udp"  # GDM network discovery
      - "32413:32413/udp"  # GDM network discovery
      - "32414:32414/udp"  # GDM network discovery
      - "32469:32469/tcp"  # Plex DLNA Server
{% endif %}
    environment:
      - TZ={{ plex_timezone }}
      - PLEX_UID=0  # Run as root (unprivileged LXC UID mapping)
      - PLEX_GID=0
{% if vault_plex_claim_token is defined and vault_plex_claim_token %}
      - PLEX_CLAIM={{ vault_plex_claim_token }}
{% endif %}
    volumes:
      - {{ plex_config_dir }}:/config
      - {{ plex_movies_dir }}:/data/movies:ro  # Read-only mount for movies
      - {{ plex_tv_dir }}:/data/tv:ro  # Read-only mount for TV shows
      - /tmp/plex-transcode:/transcode  # Transcode directory (local for performance)
{% if plex_enable_gpu %}
    devices:
      - /dev/dri:/dev/dri  # AMD GPU passthrough for hardware transcoding
    # Group memberships for GPU access
    group_add:
      - "44"   # video group
      - "993"  # render group
{% endif %}

{% if plex_network != 'host' %}
networks:
  {{ plex_docker_network }}:
    external: true
{% endif %}
