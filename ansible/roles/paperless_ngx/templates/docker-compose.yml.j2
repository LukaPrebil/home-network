---
# Docker Compose file for Paperless-ngx

services:
  paperless-broker:
    image: redis:{{ paperless_ngx_redis_version }}
    container_name: paperless-redis
    restart: unless-stopped
    volumes:
      - {{ paperless_ngx_base_dir }}/redisdata:/data

  paperless-db:
    image: postgres:{{ paperless_ngx_postgres_version }}
    container_name: paperless-db
    restart: unless-stopped
    volumes:
      - {{ paperless_ngx_base_dir }}/pgdata:/var/lib/postgresql
    # Secrets live in the 0600 env_file, not inline here.
    env_file:
      - {{ paperless_ngx_base_dir }}/paperless.env
    environment:
      POSTGRES_DB: {{ paperless_ngx_db_name }}
      POSTGRES_USER: {{ paperless_ngx_db_user }}

  paperless-web:
    image: ghcr.io/paperless-ngx/paperless-ngx:{{ paperless_ngx_version }}
    container_name: paperless-ngx
    restart: unless-stopped
    depends_on:
      - paperless-db
      - paperless-broker
    ports:
      - "{{ paperless_ngx_port }}:8000"
    networks:
      - default
      - {{ paperless_ngx_docker_network }}
    volumes:
      - {{ paperless_ngx_base_dir }}/data:/usr/src/paperless/data
      - {{ paperless_ngx_nfs_mount_point }}/media:/usr/src/paperless/media
      - {{ paperless_ngx_nfs_mount_point }}/export:/usr/src/paperless/export
      - {{ paperless_ngx_base_dir }}/consume:/usr/src/paperless/consume
    # Secrets (DBPASS, SECRET_KEY, ADMIN_PASSWORD) live in the 0600 env_file.
    env_file:
      - {{ paperless_ngx_base_dir }}/paperless.env
    environment:
      PAPERLESS_REDIS: redis://paperless-broker:6379
      # v3 stopped inferring the engine from PAPERLESS_DBHOST; Postgres users must set it explicitly.
      PAPERLESS_DBENGINE: postgresql
      PAPERLESS_DBHOST: paperless-db
      PAPERLESS_DBNAME: {{ paperless_ngx_db_name }}
      PAPERLESS_DBUSER: {{ paperless_ngx_db_user }}
      PAPERLESS_TIME_ZONE: {{ paperless_ngx_time_zone }}
      PAPERLESS_OCR_LANGUAGE: {{ paperless_ngx_ocr_language }}
      PAPERLESS_OCR_LANGUAGES: {{ paperless_ngx_ocr_install_languages }}
      PAPERLESS_ADMIN_USER: {{ paperless_ngx_admin_user }}
      PAPERLESS_URL: https://documents.{{ traefik_domain | default('lukapg.dev') }}

networks:
  {{ paperless_ngx_docker_network }}:
    external: true
