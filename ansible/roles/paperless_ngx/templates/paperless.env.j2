# Paperless-ngx secrets - managed by Ansible, do not edit manually
# Rendered at 0600; kept out of the world-readable compose file. Referenced by
# both the db and web services. Compose v2 interpolates env_file values, so a $
# in a secret must be doubled.
POSTGRES_PASSWORD="{{ vault_paperless_db_password | replace('$', '$$') }}"
PAPERLESS_DBPASS="{{ vault_paperless_db_password | replace('$', '$$') }}"
PAPERLESS_SECRET_KEY="{{ vault_paperless_secret_key | replace('$', '$$') }}"
PAPERLESS_ADMIN_PASSWORD="{{ vault_paperless_admin_password | replace('$', '$$') }}"
