---
# Traefik dynamic configuration
# This file is managed by Ansible - do not edit manually
# Add custom middlewares, routers, and services here

http:
  # Middlewares
  middlewares:
    # Security headers
    security-headers:
      headers:
        customResponseHeaders:
          X-Robots-Tag: "noindex,nofollow,nosnippet,noarchive,notranslate,noimageindex"
        sslProxyHeaders:
          X-Forwarded-Proto: https
        referrerPolicy: "strict-origin-when-cross-origin"
        contentTypeNosniff: true
        browserXssFilter: true
        forceSTSHeader: true
        stsIncludeSubdomains: true
        stsSeconds: 31536000
        stsPreload: true
        # frameDeny removed - breaks some applications like Home Assistant

    # Headers for proxied applications (Home Assistant, Uptime Kuma, etc.)
    proxy-headers:
      headers:
        customRequestHeaders:
          X-Forwarded-Proto: "https"
        sslProxyHeaders:
          X-Forwarded-Proto: https
        # Traefik automatically adds:
        # - X-Forwarded-For
        # - X-Forwarded-Host
        # - X-Real-IP

    # Rate limiting
    rate-limit:
      rateLimit:
        average: 100
        burst: 50
        period: 1m

    # IP whitelist for internal services (optional)
    # internal-whitelist:
    #   ipWhiteList:
    #     sourceRange:
    #       - "192.168.0.0/16"
    #       - "10.0.0.0/8"

    # Redirect to HTTPS
    https-redirect:
      redirectScheme:
        scheme: https
        permanent: true

{% if traefik_cloudflare_real_ip_enabled | default(false) %}
    # Cloudflare real client IP extraction (traefik-warp plugin)
    # Auto-fetches Cloudflare IP ranges and extracts real client IP
    cloudflare-real-ip:
      plugin:
        traefikwarp:
          provider: cloudflare
          trustIp:
            cloudflare:
              - "192.168.1.0/24"
{% endif %}

{% if traefik_crowdsec_enabled | default(false) %}
    # CrowdSec bouncer — blocks IPs flagged by CrowdSec engine
    crowdsec:
      plugin:
        crowdsec:
          enabled: true
          crowdsecMode: stream
          crowdsecLapiScheme: http
          crowdsecLapiHost: "crowdsec:8080"
          crowdsecLapiKey: "{{ traefik_crowdsec_bouncer_key }}"
{% endif %}

{# Build security middleware chain applied to all public routes #}
{% set _ns = namespace(security_mw = []) %}
{% if traefik_cloudflare_real_ip_enabled | default(false) %}
{%   set _ns.security_mw = _ns.security_mw + ['cloudflare-real-ip'] %}
{% endif %}
{% if traefik_crowdsec_enabled | default(false) %}
{%   set _ns.security_mw = _ns.security_mw + ['crowdsec'] %}
{% endif %}

  # Routers - HTTPS only (HTTP will auto-redirect)
  routers:
{% if traefik_acme_enabled | default(false) %}
    # Home Assistant
    ha-secure:
      rule: "Host(`ha.{{ traefik_domain | default('lukapg.dev') }}`)"
      entryPoints:
        - websecure
      service: homeassistant
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"
      middlewares:
{% for mw in _ns.security_mw %}
        - {{ mw }}
{% endfor %}
        - proxy-headers
        - security-headers
        - rate-limit

    # Uptime Kuma (kuma subdomain)
    kuma-secure:
      rule: "Host(`kuma.{{ traefik_domain | default('lukapg.dev') }}`)"
      entryPoints:
        - websecure
      service: uptimekuma
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"
      middlewares:
{% for mw in _ns.security_mw %}
        - {{ mw }}
{% endfor %}
        - proxy-headers
        - security-headers

    # Uptime Kuma (status subdomain - same backend)
    status-secure:
      rule: "Host(`status.{{ traefik_domain | default('lukapg.dev') }}`)"
      entryPoints:
        - websecure
      service: uptimekuma
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"
      middlewares:
{% for mw in _ns.security_mw %}
        - {{ mw }}
{% endfor %}
        - proxy-headers
        - security-headers

    # Glances
    glances-secure:
      rule: "Host(`glances.{{ traefik_domain | default('lukapg.dev') }}`)"
      entryPoints:
        - websecure
      service: glances
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"
      middlewares:
{% for mw in _ns.security_mw %}
        - {{ mw }}
{% endfor %}
        - security-headers

    # Immich Photo Management
    immich-secure:
      rule: "Host(`photos.{{ traefik_domain | default('lukapg.dev') }}`)"
      entryPoints:
        - websecure
      service: immich
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"
      middlewares:
{% for mw in _ns.security_mw %}
        - {{ mw }}
{% endfor %}
        - proxy-headers
        - security-headers

    # Grafana Monitoring
    grafana-secure:
      rule: "Host(`grafana.{{ traefik_domain | default('lukapg.dev') }}`)"
      entryPoints:
        - websecure
      service: grafana
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"
      middlewares:
{% for mw in _ns.security_mw %}
        - {{ mw }}
{% endfor %}
        - proxy-headers
        - security-headers

    # Jellyfin Media Server
    jellyfin-secure:
      rule: "Host(`jellyfin.{{ traefik_domain | default('lukapg.dev') }}`)"
      entryPoints:
        - websecure
      service: jellyfin
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"
      middlewares:
{% for mw in _ns.security_mw %}
        - {{ mw }}
{% endfor %}
        - proxy-headers

    # Paperless-ngx Document Management
    paperless-secure:
      rule: "Host(`documents.{{ traefik_domain | default('lukapg.dev') }}`)"
      entryPoints:
        - websecure
      service: paperless
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"
      middlewares:
{% for mw in _ns.security_mw %}
        - {{ mw }}
{% endfor %}
        - proxy-headers
        - security-headers

    # ATProto PDS (Personal Data Server)
    # Handles are verified via DNS TXT records (not wildcard subdomains)
    # so only pds.lukapg.dev needs routing — no *.pds.lukapg.dev needed.
    # This allows Cloudflare proxy (orange cloud) to hide the origin IP.
    pds-secure:
      rule: "Host(`pds.{{ traefik_domain | default('lukapg.dev') }}`)"
      entryPoints:
        - websecure
      service: pds
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"
      middlewares:
{% for mw in _ns.security_mw %}
        - {{ mw }}
{% endfor %}
        - proxy-headers
        - security-headers
        - rate-limit

{% endif %}

  # Services - backend targets
  services:
{% if traefik_acme_enabled | default(false) %}
    homeassistant:
      loadBalancer:
        servers:
          - url: "http://192.168.1.144:8123"
        passHostHeader: true

    uptimekuma:
      loadBalancer:
        servers:
          - url: "http://192.168.1.140:3001"
        passHostHeader: true

    glances:
      loadBalancer:
        servers:
          - url: "http://192.168.1.110:61208"
        passHostHeader: true

    immich:
      loadBalancer:
        servers:
          - url: "http://192.168.1.141:2283"
        passHostHeader: true

    grafana:
      loadBalancer:
        servers:
          - url: "http://192.168.1.146:3000"
        passHostHeader: true

    jellyfin:
      loadBalancer:
        servers:
          - url: "http://192.168.1.147:8096"
        passHostHeader: true

    paperless:
      loadBalancer:
        servers:
          - url: "http://192.168.1.140:8010"
        passHostHeader: true

    pds:
      loadBalancer:
        servers:
          - url: "http://192.168.1.140:3000"
        passHostHeader: true
{% endif %}

# TLS configuration
tls:
  options:
    default:
      minVersion: VersionTLS12  # Keep TLS 1.2 for compatibility
      maxVersion: VersionTLS13  # Prefer TLS 1.3
      sniStrict: true
      # Modern cipher suites (TLS 1.3 + TLS 1.2 fallback)
      # TLS 1.3 ciphers are negotiated automatically
      cipherSuites:
        # TLS 1.2 cipher suites (for fallback compatibility)
        - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
        - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
        - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305
        - TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305
      # ALPN protocols (enables HTTP/2 & HTTP/3)
      alpnProtocols:
        - h2      # HTTP/2
        - http/1.1
