---
# Traefik dynamic configuration
# This file is managed by Ansible - do not edit manually
# Add custom middlewares, routers, and services here

http:
  # Middlewares
  middlewares:
    # Security headers
    security-headers:
      headers:
        customResponseHeaders:
          X-Robots-Tag: "noindex,nofollow,nosnippet,noarchive,notranslate,noimageindex"
        sslProxyHeaders:
          X-Forwarded-Proto: https
        referrerPolicy: "strict-origin-when-cross-origin"
        contentTypeNosniff: true
        browserXssFilter: true
        forceSTSHeader: true
        stsIncludeSubdomains: true
        stsSeconds: 31536000
        stsPreload: true
        # frameDeny removed - breaks some applications like Home Assistant

    # Headers for proxied applications (Home Assistant, Uptime Kuma, etc.)
    proxy-headers:
      headers:
        customRequestHeaders:
          X-Forwarded-Proto: "https"
        sslProxyHeaders:
          X-Forwarded-Proto: https
        # Traefik automatically adds:
        # - X-Forwarded-For
        # - X-Forwarded-Host
        # - X-Real-IP

    # Rate limiting
    rate-limit:
      rateLimit:
        average: 100
        burst: 50
        period: 1m

    # LAN + tailnet-only allow-list, attached to internal-only routers.
    # Traefik 3.x: ipAllowList replaces deprecated ipWhiteList.
    # Tailnet CIDRs (100.64.0.0/10, fd7a:115c:a1e0::/48) are universal
    # across all Tailscale tailnets, not tailnet-specific.
    # NOTE: When VLANs migrate (Mgmt 10, Trusted 20, Servers 30, DMZ 60),
    # update sourceRange to enumerate the trusted VLAN CIDRs and exclude
    # IoT/Cameras/Guest. Today's flat /24 means everyone-on-Wi-Fi can
    # reach internal routes; tightening only meaningful after VLAN migration.
    lan-only:
      ipAllowList:
        sourceRange:
          - "127.0.0.1/32"           # local probes / Traefik ping
          - "192.168.1.0/24"         # current flat LAN
          - "100.64.0.0/10"          # Tailscale CGNAT IPv4
          - "fd7a:115c:a1e0::/48"    # Tailscale CGNAT IPv6

    # Redirect to HTTPS
    https-redirect:
      redirectScheme:
        scheme: https
        permanent: true

{% if traefik_cloudflare_real_ip_enabled | default(false) %}
    # Cloudflare real client IP extraction (traefik-warp plugin)
    # Auto-fetches Cloudflare IP ranges and extracts real client IP
    cloudflare-real-ip:
      plugin:
        traefikwarp:
          provider: cloudflare
          trustIp:
            cloudflare:
              - "192.168.1.0/24"
{% endif %}

{% if traefik_crowdsec_enabled | default(false) %}
    # CrowdSec bouncer - blocks IPs flagged by CrowdSec engine
    crowdsec:
      plugin:
        crowdsec:
          enabled: true
          crowdsecMode: stream
          crowdsecLapiScheme: http
          crowdsecLapiHost: "crowdsec:8080"
          crowdsecLapiKey: "{{ traefik_crowdsec_bouncer_key }}"
{% endif %}

{# Build security middleware chain applied to all public routes #}
{% set _ns = namespace(security_mw = []) %}
{% if traefik_cloudflare_real_ip_enabled | default(false) %}
{%   set _ns.security_mw = _ns.security_mw + ['cloudflare-real-ip'] %}
{% endif %}
{% if traefik_crowdsec_enabled | default(false) %}
{%   set _ns.security_mw = _ns.security_mw + ['crowdsec'] %}
{% endif %}

  # Routers - HTTPS only (HTTP will auto-redirect)
  routers:
{% if traefik_acme_enabled | default(false) %}
    # Home Assistant
    ha-secure:
      rule: "Host(`ha.{{ traefik_domain | default('lukapg.dev') }}`)"
      entryPoints:
        - websecure
      service: homeassistant
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"
      middlewares:
{% for mw in _ns.security_mw %}
        - {{ mw }}
{% endfor %}
        - proxy-headers
        - security-headers
        - rate-limit

    # Uptime Kuma (kuma subdomain)
    kuma-secure:
      rule: "Host(`kuma.{{ traefik_domain | default('lukapg.dev') }}`)"
      entryPoints:
        - websecure
      service: uptimekuma
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"
      middlewares:
{% for mw in _ns.security_mw %}
        - {{ mw }}
{% endfor %}
        - proxy-headers
        - security-headers
        - rate-limit

    # Uptime Kuma (status subdomain - same backend)
    status-secure:
      rule: "Host(`status.{{ traefik_domain | default('lukapg.dev') }}`)"
      entryPoints:
        - websecure
      service: uptimekuma
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"
      middlewares:
{% for mw in _ns.security_mw %}
        - {{ mw }}
{% endfor %}
        - proxy-headers
        - security-headers
        - rate-limit

    # Immich Photo Management
    immich-secure:
      rule: "Host(`photos.{{ traefik_domain | default('lukapg.dev') }}`)"
      entryPoints:
        - websecure
      service: immich
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"
      middlewares:
{% for mw in _ns.security_mw %}
        - {{ mw }}
{% endfor %}
        - proxy-headers
        - security-headers
        - rate-limit

    # Grafana Monitoring
    grafana-secure:
      rule: "Host(`grafana.{{ traefik_domain | default('lukapg.dev') }}`)"
      entryPoints:
        - websecure
      service: grafana
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"
      middlewares:
{% for mw in _ns.security_mw %}
        - {{ mw }}
{% endfor %}
        - proxy-headers
        - security-headers
        - rate-limit

    # Jellyfin Media Server
    jellyfin-secure:
      rule: "Host(`jellyfin.{{ traefik_domain | default('lukapg.dev') }}`)"
      entryPoints:
        - websecure
      service: jellyfin
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"
      middlewares:
{% for mw in _ns.security_mw %}
        - {{ mw }}
{% endfor %}
        - proxy-headers
        - security-headers
        - rate-limit

    # Paperless-ngx Document Management
    paperless-secure:
      rule: "Host(`documents.{{ traefik_domain | default('lukapg.dev') }}`)"
      entryPoints:
        - websecure
      service: paperless
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"
      middlewares:
{% for mw in _ns.security_mw %}
        - {{ mw }}
{% endfor %}
        - proxy-headers
        - security-headers
        - rate-limit

    # ATProto PDS (Personal Data Server)
    # Handles are verified via DNS TXT records (not wildcard subdomains)
    # so only pds.lukapg.dev needs routing - no *.pds.lukapg.dev needed.
    # This allows Cloudflare proxy (orange cloud) to hide the origin IP.
    pds-secure:
      rule: "Host(`pds.{{ traefik_domain | default('lukapg.dev') }}`)"
      entryPoints:
        - websecure
      service: pds
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"
      middlewares:
{% for mw in _ns.security_mw %}
        - {{ mw }}
{% endfor %}
        - proxy-headers
        - security-headers
        - rate-limit

    # Mattermost team chat - public via Cloudflare (orange cloud), like PDS.
    # Traefik passes the WebSocket upgrade through by default (Mattermost needs it).
    mattermost-secure:
      rule: "Host(`chat.{{ traefik_domain | default('lukapg.dev') }}`)"
      entryPoints:
        - websecure
      service: mattermost
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"
      middlewares:
{% for mw in _ns.security_mw %}
        - {{ mw }}
{% endfor %}
        - proxy-headers
        - security-headers
        - rate-limit

    # ─── Internal-only routers (LAN + tailnet only) ───
    # No Cloudflare proxy, no public DNS - split-DNS only via AdGuard.
    # Middleware chain: `lan-only` first (drops non-LAN/non-tailnet),
    # `crowdsec` next (brute-force detection on internal admin endpoints
    # - Proxmox login is the highest-value target in the homelab), then
    # `proxy-headers` and `security-headers`.
    # Intentionally omitted: `cloudflare-real-ip` (no CF in path) and
    # `rate-limit` (admin SPAs poll fast enough to brush 100 req/min).

    # Proxmox VE (n5p) - HTTPS self-signed backend, noVNC over WebSocket
    proxmox-secure:
      rule: "Host(`n5p.{{ traefik_domain | default('lukapg.dev') }}`)"
      entryPoints:
        - websecure
      service: proxmox
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"
      middlewares:
        - lan-only
{% if traefik_crowdsec_enabled | default(false) %}
        - crowdsec
{% endif %}
        - proxy-headers
        - security-headers

    # TrueNAS Scale - HTTPS self-signed backend, WebSocket Web Shell
    truenas-secure:
      rule: "Host(`tn.{{ traefik_domain | default('lukapg.dev') }}`)"
      entryPoints:
        - websecure
      service: truenas
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"
      middlewares:
        - lan-only
{% if traefik_crowdsec_enabled | default(false) %}
        - crowdsec
{% endif %}
        - proxy-headers
        - security-headers

    # Omada Controller - HTTPS self-signed backend, WebSocket device map
    omada-secure:
      rule: "Host(`omada.{{ traefik_domain | default('lukapg.dev') }}`)"
      entryPoints:
        - websecure
      service: omada
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"
      middlewares:
        - lan-only
{% if traefik_crowdsec_enabled | default(false) %}
        - crowdsec
{% endif %}
        - proxy-headers
        - security-headers

    # AdGuard Home (primary) - plain HTTP backend on adguard LXC
    adguard-secure:
      rule: "Host(`adguard.{{ traefik_domain | default('lukapg.dev') }}`)"
      entryPoints:
        - websecure
      service: adguard
      tls:
        certResolver: letsencrypt
        domains:
          - main: "{{ traefik_domain }}"
            sans:
              - "*.{{ traefik_domain }}"
      middlewares:
        - lan-only
{% if traefik_crowdsec_enabled | default(false) %}
        - crowdsec
{% endif %}
        - proxy-headers
        - security-headers

{% endif %}

  # Services - backend targets
  services:
{% if traefik_acme_enabled | default(false) %}
    homeassistant:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars['haos']['ansible_host'] }}:8123"
        passHostHeader: true

    uptimekuma:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars['containers']['ansible_host'] }}:3001"
        passHostHeader: true



    immich:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars['immich']['ansible_host'] }}:2283"
        passHostHeader: true

    grafana:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars['monitoring']['ansible_host'] }}:3000"
        passHostHeader: true

    jellyfin:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars['media']['ansible_host'] }}:8096"
        passHostHeader: true

    paperless:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars['containers']['ansible_host'] }}:8010"
        passHostHeader: true

    pds:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars['containers']['ansible_host'] }}:3000"
        passHostHeader: true

    mattermost:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars['mattermost']['ansible_host'] }}:8065"
        passHostHeader: true

    # ─── Internal-only service backends ───
    # HTTPS-self-signed backends reference per-router serversTransports
    # defined below; AdGuard speaks plain HTTP so no transport block.

    proxmox:
      loadBalancer:
        servers:
          - url: "https://{{ hostvars['n5p']['ansible_host'] }}:8006"
        passHostHeader: true
        serversTransport: proxmox-tls

    truenas:
      loadBalancer:
        servers:
          - url: "https://{{ hostvars['tn-storage']['ansible_host'] }}:443"
        passHostHeader: true
        serversTransport: truenas-tls

    omada:
      loadBalancer:
        servers:
          - url: "https://{{ hostvars['omada']['ansible_host'] }}:8043"
        passHostHeader: true
        serversTransport: omada-tls

    adguard:
      loadBalancer:
        servers:
          - url: "http://{{ hostvars['adguard']['ansible_host'] }}:3000"
        passHostHeader: true
{% endif %}

  # serversTransports - per-router upstream TLS verification policy.
  # Internal HTTPS backends present self-signed certs; insecureSkipVerify
  # is acceptable here because the connection is LAN-only and the backend
  # identity is implicit in the routing rule (Host header → fixed IP).
  # See plan Risks §11 for the residual LAN-MITM risk this accepts.
  serversTransports:
{% if traefik_acme_enabled | default(false) %}
    proxmox-tls:
      insecureSkipVerify: true
    truenas-tls:
      insecureSkipVerify: true
      # If TrueNAS Web Shell hangs on first connect (known H2-over-WS
      # quirk on Scale 25.x), add: disableHTTP2: true
    omada-tls:
      insecureSkipVerify: true
{% endif %}

# TLS configuration
tls:
  options:
    default:
      minVersion: VersionTLS12  # Keep TLS 1.2 for compatibility
      maxVersion: VersionTLS13  # Prefer TLS 1.3
      sniStrict: true
      # Modern cipher suites (TLS 1.3 + TLS 1.2 fallback)
      # TLS 1.3 ciphers are negotiated automatically
      cipherSuites:
        # TLS 1.2 cipher suites (for fallback compatibility)
        - TLS_ECDHE_ECDSA_WITH_AES_128_GCM_SHA256
        - TLS_ECDHE_RSA_WITH_AES_128_GCM_SHA256
        - TLS_ECDHE_ECDSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_RSA_WITH_AES_256_GCM_SHA384
        - TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305
        - TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305
      # ALPN protocols (enables HTTP/2 & HTTP/3)
      alpnProtocols:
        - h2      # HTTP/2
        - http/1.1
