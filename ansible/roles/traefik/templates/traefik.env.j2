# Traefik secrets - managed by Ansible, do not edit manually
# Rendered at 0600; kept out of the world-readable compose file.
# Compose v2 interpolates env_file values, so $ in a secret must be doubled.
{% if traefik_acme_challenge_type | default('http') == 'dns' %}
CF_DNS_API_TOKEN="{{ traefik_cloudflare_dns_api_token | replace('$', '$$') }}"
{% endif %}
