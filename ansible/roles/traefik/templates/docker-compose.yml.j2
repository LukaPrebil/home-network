---
# Docker Compose file for Traefik
# Note: 'version' field is obsolete in Compose v2 and has been removed

services:
  traefik:
    image: traefik:{{ traefik_version }}
    container_name: traefik
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    networks:
      {{ traefik_docker_network }}:
        ipv4_address: "{{ traefik_network_traefik_address }}"
    ports:
      - "{{ traefik_http_port }}:80"
      - "{{ traefik_https_port }}:443"
{% if traefik_http3_enabled %}
      - "{{ traefik_https_port }}:443/udp"  # HTTP/3 (QUIC)
{% endif %}
{% if traefik_dashboard_enabled %}
      - "{{ traefik_dashboard_port }}:8080"
{% endif %}
{% if traefik_metrics_enabled %}
      - "{{ traefik_metrics_port }}:8082"  # Prometheus metrics
{% endif %}
    volumes:
      # Traefik configuration
      - {{ traefik_config_dir }}/traefik.yml:/etc/traefik/traefik.yml:ro
      # Dynamic configuration directory
      - {{ traefik_file_provider_directory }}:/etc/traefik/dynamic:ro
{% if traefik_acme_enabled %}
      # ACME certificates
      - {{ traefik_acme_storage }}:/acme.json
{% endif %}
{% if traefik_access_logs | default(true) %}
      # Access logs (file-based for CrowdSec and log analysis)
      - {{ traefik_logs_dir }}:/var/log/traefik
{% endif %}
{% if traefik_docker_provider_enabled %}
      # Docker socket (read-only)
      - /var/run/docker.sock:/var/run/docker.sock:ro
{% endif %}
    # Secrets (CF_DNS_API_TOKEN) live in the 0600 env_file, not inline here.
    env_file:
      - {{ traefik_base_dir }}/traefik.env
    environment:
      - TZ={{ timezone | default('UTC') }}
    # Dashboard: LAN-only via http://{{ ansible_host | default('localhost') }}:{{ traefik_dashboard_port }}
    # Removed from public exposure - no Docker labels for public routing

networks:
  {{ traefik_docker_network }}:
    external: true
