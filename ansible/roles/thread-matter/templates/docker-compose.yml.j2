---
# Docker Compose for Thread Matter Stack
# Managed by Ansible - DO NOT EDIT MANUALLY
#
# Services:
#   - OpenThread Border Router (OTBR) - Thread network coordinator
#   - Python Matter Server - Matter device controller for Home Assistant

services:
  otbr:
    image: {{ otbr_image }}:{{ otbr_version }}
    container_name: {{ otbr_container_name }}
    restart: unless-stopped
    # OTBR requires privileged mode for:
    # - USB device access
    # - Network namespace manipulation (wpan0 interface)
    # - iptables for NAT64/DNS64
    privileged: true
    # Host networking required for Thread/mDNS
    network_mode: host
    volumes:
      - {{ otbr_data_dir }}:/var/lib/thread
    devices:
      - {{ thread_usb_device }}:/dev/ttyACM0
    environment:
      TZ: {{ thread_matter_timezone }}
      # Radio URL for the Thread dongle
      RADIO_URL: "spinel+hdlc+uart:///dev/ttyACM0?uart-baudrate=460800"
      # Backbone interface for border routing
      BACKBONE_IF: "{{ otbr_backbone_interface }}"
      BORDER_ROUTING: "1"
      BACKBONE_ROUTER: "1"
      NAT64: "0"
      DNS64: "0"
      WEB_GUI: "1"
      REST_API: "1"
      # Bind REST API to all interfaces so it's accessible from other hosts
      REST_HOST: "0.0.0.0"
      # Bind Web GUI to all interfaces
      HTTP_HOST: "0.0.0.0"
      HTTP_PORT: "{{ otbr_port_web }}"
    # Note: sysctls cannot be used with network_mode: host
    # IP forwarding is configured on the host via prerequisites.yml
    healthcheck:
      # Check if otbr-agent process is running (state can be 'disabled' until network is formed)
      test: ["CMD-SHELL", "pgrep -x otbr-agent > /dev/null"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 60s

  matter-server:
    image: {{ matter_server_image }}:{{ matter_server_version }}
    container_name: {{ matter_server_container_name }}
    restart: unless-stopped
    # Host networking required for mDNS discovery and Matter communication
    network_mode: host
    volumes:
      - {{ matter_server_data_dir }}:/data
      - /run/dbus:/run/dbus:ro
    environment:
      TZ: {{ thread_matter_timezone }}
    command:
      - --storage-path
      - /data
      - --port
      - "{{ matter_server_port }}"
      - --log-level
      - info
    depends_on:
      otbr:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "python3", "-c", "import socket; s=socket.socket(); s.connect(('localhost', {{ matter_server_port }})); s.close()"]
      interval: 30s
      timeout: 10s
      retries: 3
      start_period: 30s
