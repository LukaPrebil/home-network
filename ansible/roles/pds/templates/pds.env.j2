# ATProto PDS environment configuration
# Managed by Ansible - do not edit manually
PDS_HOSTNAME={{ pds_hostname }}
PDS_JWT_SECRET="{{ vault_pds_jwt_secret | replace('$', '$$') }}"
PDS_ADMIN_PASSWORD="{{ vault_pds_admin_password | replace('$', '$$') }}"
PDS_PLC_ROTATION_KEY_K256_PRIVATE_KEY_HEX="{{ vault_pds_plc_rotation_key }}"
PDS_DATA_DIRECTORY=/pds
PDS_BLOBSTORE_DISK_LOCATION=/pds/blocks
PDS_BLOB_UPLOAD_LIMIT={{ pds_blob_upload_limit }}
PDS_DID_PLC_URL={{ pds_did_plc_url }}
PDS_BSKY_APP_VIEW_URL={{ pds_bsky_app_view_url }}
PDS_BSKY_APP_VIEW_DID={{ pds_bsky_app_view_did }}
PDS_REPORT_SERVICE_URL={{ pds_report_service_url }}
PDS_REPORT_SERVICE_DID={{ pds_report_service_did }}
PDS_CRAWLERS={{ pds_crawlers }}
PDS_INVITE_REQUIRED={{ pds_invite_required | lower }}
PDS_RATE_LIMITS_ENABLED={{ pds_rate_limits_enabled | lower }}
LOG_ENABLED=true
