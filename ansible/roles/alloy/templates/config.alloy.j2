// Grafana Alloy configuration
// Managed by Ansible - do not edit manually

// Logging configuration
logging {
  level  = "info"
  format = "logfmt"
}

// There is deliberately no prometheus.remote_write here. Host metrics come from
// the standalone node_exporter, which Prometheus scrapes directly and which covers
// every host this role runs on. Alloy's own prometheus.exporter.unix duplicated
// those metrics and forwarded them to a receiver Prometheus never had enabled, so
// every push 404d once a minute and dropped its whole batch. Alloy's own internal
// metrics still reach Prometheus, via the :12345 scrape rather than a push.

// Loki - host logs, read straight from the systemd journal.
// This used to tail /var/log/syslog. Debian 13 ships no rsyslog, so that file never
// existed on n5p or rpi4, and loki.source.file reported healthy while shipping nothing
// for the whole of Loki's retention - which silently disabled Error Log Spike, Service
// Crash Detected and Authentication Failure Spike on both hosts. journald needs no
// package and exists on every host, so the empty-target failure mode goes away.
// max_age bounds the one-time backfill on the converge that switches a host over.
loki.source.journal "system_logs" {
  max_age = "12h"

  labels = {
    job      = "system",
    hostname = "{{ inventory_hostname }}",
  }

  relabel_rules = loki.relabel.journal.rules
  forward_to    = [loki.write.logs.receiver]
}

// Alloy drops every __journal_* label before forwarding, so the unit name has to be
// promoted explicitly or there is no way to tell which service produced a line.
loki.relabel "journal" {
  forward_to = []

  rule {
    source_labels = ["__journal__systemd_unit"]
    target_label  = "unit"
  }
}

{% if alloy_docker_installed %}
// Loki - Docker container logs
// loki.source.docker tails only the targets it is handed; it discovers nothing on
// its own. With an empty targets list it starts cleanly, reports healthy and ships
// zero lines, which is how container logs went missing fleet-wide without an error.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

loki.source.docker "docker_logs" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.docker.containers.targets
  forward_to = [loki.process.add_docker_labels.receiver]
  relabel_rules = loki.relabel.docker.rules
}

// Add Docker-specific labels
loki.relabel "docker" {
  forward_to = []

  // Docker reports container names with a leading slash, so the raw label would be
  // "/immich_server" and every query would have to carry it. Capture past the slash.
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }

  rule {
    source_labels = ["__meta_docker_container_log_stream"]
    target_label  = "stream"
  }
}

// Process Docker logs to add metadata
loki.process "add_docker_labels" {
  forward_to = [loki.write.logs.receiver]

  stage.static_labels {
    values = {
      hostname = "{{ inventory_hostname }}",
      job      = "docker",
    }
  }
}
{% endif %}

// Loki remote write to monitoring stack
loki.write "logs" {
  endpoint {
    url = "{{ alloy_loki_url }}/loki/api/v1/push"
  }

  external_labels = {
    hostname = "{{ inventory_hostname }}",
  }
}
