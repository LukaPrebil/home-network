---
# Docker Compose for matterjs-server
# Managed by Ansible - DO NOT EDIT MANUALLY
#
# Note: Matter Server must use host networking for mDNS discovery
# It connects to OTBR over the network for Thread device support

services:
  matter-server:
    image: {{ matter_server_image }}:{{ matter_server_version }}
    container_name: {{ matter_server_container_name }}
    restart: unless-stopped
    # Host networking required for mDNS discovery and Matter communication
    network_mode: host
    volumes:
      - {{ matter_server_data_dir }}:/data
      - /run/dbus:/run/dbus:ro
    environment:
      TZ: {{ matter_server_timezone }}
    command:
      - --storage-path
      - /data
      - --port
      - "{{ matter_server_port }}"
      - --log-level
      - "{{ matter_server_log_level }}"
{% if matter_server_time_sync %}
      - --enable-time-sync
{% endif %}
    # No compose healthcheck: the image ships its own; the old python3-based check can never pass in this Node image, and autoheal would restart-loop the permanently-unhealthy container
    labels:
      - "autoheal=true"
