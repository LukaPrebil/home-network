---
# Docker Compose for Autoheal
# Managed by Ansible - DO NOT EDIT MANUALLY
#
# Monitors containers with healthchecks and restarts unhealthy ones.
# Containers must have the label "autoheal=true" to be monitored.

services:
  autoheal:
    image: {{ autoheal_image_ref }}
    container_name: {{ autoheal_container_name }}
    restart: unless-stopped
    environment:
      TZ: {{ autoheal_timezone }}
      # Reach the Docker API through the socket-proxy, never the raw socket.
      # willfarrell/autoheal rewrites a tcp:// DOCKER_SOCK to http:// and drops
      # the unix-socket path automatically.
      DOCKER_SOCK: "{{ docker_socket_proxy_endpoint }}"
      AUTOHEAL_CONTAINER_LABEL: "{{ autoheal_container_label }}"
      AUTOHEAL_INTERVAL: "{{ autoheal_interval }}"
      AUTOHEAL_START_PERIOD: "{{ autoheal_start_period }}"
      AUTOHEAL_DEFAULT_STOP_TIMEOUT: "{{ autoheal_stop_timeout }}"
    networks:
      - {{ docker_socket_proxy_network }}

networks:
  {{ docker_socket_proxy_network }}:
    external: true
