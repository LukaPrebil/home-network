# RustFS environment configuration
# Managed by Ansible - do not edit manually
#
# Credentials come from SOPS. Values are hex, so neither docker env_file
# quoting nor compose `$` interpolation can mangle them.
RUSTFS_ACCESS_KEY={{ rustfs_root_access_key }}
RUSTFS_SECRET_KEY={{ rustfs_root_secret_key }}
RUSTFS_ADDRESS=:9000
RUSTFS_VOLUMES={{ rustfs_data_dir }}
RUSTFS_CONSOLE_ENABLE=false
RUSTFS_OBS_LOGGER_LEVEL=error
