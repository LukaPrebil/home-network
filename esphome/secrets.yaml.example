wifi_ssid: "your-iot-ssid"
wifi_password: "your-wifi-password"
api_key: "generate-with-esphome"
ota_password: "your-ota-password"

# Fallback access point the node brings up when it cannot join the IoT SSID.
# It is reachable by anyone in RF range, so treat the password as a real
# credential rather than a recovery convenience.
ap_ssid: "your-fallback-ap-ssid"
ap_password: "your-fallback-ap-password"
