# Rendered env files at any depth. The .j2 sources under ansible/roles/*/templates
# are deliberately tracked and must stay tracked; they hold variable references, not values.
**/.env*
!**/*.env.j2
!**/env.j2

# Key material and certificates
**/*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*
known_hosts
# Except the fleet host-key pin: it is public keys only (see
# docs/infrastructure/ansible-guide.md), and the IPs it pins are already
# published in ansible/inventory/hosts.yml. Last matching rule wins, so the
# negation must come after the unanchored known_hosts rule above.
!ansible/known_hosts
**/acme.json

# Decryption material. Only encrypted payloads belong in the repo.
# ansible.cfg reads the vault password from .vault_pass; ansible/.gitignore already
# covers that path, this repeats it unanchored so a copy at any depth is caught too.
.vault_pass
# Defensive: this repo uses ansible-vault today, but age keys are a common
# companion and keys.txt is the default output filename of age-keygen.
*.agekey
keys.txt

# Python
**/__pycache__/

# Editors and OS
.vscode/
.DS_Store

# Local tooling state
.mcp.json
.playwright-mcp/
.claude/scheduled_tasks.lock
.claude/state/

# Local artifacts
backups/
